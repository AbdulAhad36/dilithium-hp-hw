set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CGXFC7C7F23C8
set_global_assignment -name TOP_LEVEL_ENTITY keccak_core
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name TIMING_ANALYZER_MULTICORNER_ANALYSIS ON
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4

# Performance-oriented compile. Do not use Auto Fit for Fmax measurement.
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name ROUTER_TIMING_OPTIMIZATION_LEVEL MAXIMUM
set_global_assignment -name SEED 3

set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak_engine/keccak_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak_engine/theta_step.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak_engine/rho_step.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak_engine/pi_step.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak_engine/chi_step.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak_engine/iota_step.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak_engine/keccak_step_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak_engine/keccak_param_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak_engine/keccak_absorb_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak_engine/keccak_output_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak_engine/keccak_core.sv
set_global_assignment -name SDC_FILE keccak_performance.sdc

# clk stays physical. Data/control ports are virtual for a core-only benchmark.
set_instance_assignment -name VIRTUAL_PIN ON -to "rst"
set_instance_assignment -name VIRTUAL_PIN ON -to "start_i"
set_instance_assignment -name VIRTUAL_PIN ON -to "keccak_mode_i[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "message_len_i[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "output_len_i[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "stop_i"
set_instance_assignment -name VIRTUAL_PIN ON -to "busy_o"
set_instance_assignment -name VIRTUAL_PIN ON -to "done_o"
set_instance_assignment -name VIRTUAL_PIN ON -to "input_data_i[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "input_valid_i"
set_instance_assignment -name VIRTUAL_PIN ON -to "input_ready_o"
set_instance_assignment -name VIRTUAL_PIN ON -to "output_data_o[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "output_valid_o"
set_instance_assignment -name VIRTUAL_PIN ON -to "output_bytes_o[*]"
set_instance_assignment -name VIRTUAL_PIN ON -to "output_ready_i"


set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"

