set_global_assignment -name SYSTEMVERILOG_FILE ../../src/sampler/sampler_ball.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/sampler/sampler_compact.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/sampler/sampler.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/ntt/ntt_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/ntt/mod_mul.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/ntt/butterfly_unit.sv
