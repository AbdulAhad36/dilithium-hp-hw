# Evolving Dilithium project:Stage4 Keccak+sampler+memory+NTT.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CGXFC7C7F23C8
set_global_assignment -name TOP_LEVEL_ENTITY keccak_sampler_ntt
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name TIMING_ANALYZER_MULTICORNER_ANALYSIS ON
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SEED 1
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING OFF
# Timing trial: use the accepted Keccak physical-synthesis profile locally.
# Keep sampler retiming disabled and verify its original pipeline registers.
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name ROUTER_TIMING_OPTIMIZATION_LEVEL MAXIMUM
set_instance_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON -to "producer|hash|*"
set_instance_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING OFF -to "producer|sample|*"
# Restore ordinary state clock-enable mapping;readiness is predecoded in RTL.
set_global_assignment -name SDC_FILE dilithium.sdc
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak/keccak_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak/keccak_param_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak/keccak_absorb_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak/theta_step.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak/rho_step.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak/pi_step.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak/chi_step.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak/iota_step.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak/keccak_step_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak/keccak_output_unit.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak/keccak_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/keccak/keccak_dual_interleaved.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../src/sampler/sampler_pkg.sv
